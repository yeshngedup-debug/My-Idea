# Neon Auth (Managed Better Auth) — sessions and identities.
# Branch auth URL from `neon neon-auth status`.
NEON_AUTH_BASE_URL=https://<branch-auth-host>.auth.neon.app
# App-generated cookie signing secret: >= 32 chars. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEON_AUTH_COOKIE_SECRET=<at-least-32-character-random-secret>

# Neon Postgres — all application data (server-only). Use the pooled URL.
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.neon.tech/<db>?sslmode=require

# Neon Object Storage — injected by `neon deploy` / `neon env pull`. Do not hardcode.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Neon Realtime — live shortlist payment status. The secret stays server-only.
NEON_REALTIME_SECRET=<sealing-secret>
NEXT_PUBLIC_NEON_REALTIME_URL=<public-realtime-url>

# Public site origin — pins auth redirects and generated CV links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon status endpoint (/api/neon). Optional; used for branch metadata.
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# Optional.
CONTACT_EMAIL=hello@bhutantech.bt

# E2E only — seeded Neon Auth accounts; never use these in production.
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_FOUNDER_EMAIL=
E2E_FOUNDER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PAYMENT_FOUNDER_EMAIL=
E2E_PAYMENT_FOUNDER_PASSWORD=
